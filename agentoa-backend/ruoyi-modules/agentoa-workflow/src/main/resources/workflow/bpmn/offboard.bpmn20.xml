<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://agentoa.org/workflow">
  <process id="offboard" name="离职申请" isExecutable="true">
    <startEvent id="start" name="发起"/>
    <sequenceFlow id="flow-start-leader" sourceRef="start" targetRef="leaderApprove"/>
    <userTask id="leaderApprove" name="主管审批">
      <extensionElements>
        <flowable:taskListener event="create" class="org.dromara.agentoa.workflow.assigner.AssigneeTaskListener">
          <flowable:field name="rule">
            <flowable:string>LEADER</flowable:string>
          </flowable:field>
        </flowable:taskListener>
      </extensionElements>
    </userTask>
    <sequenceFlow id="flow-leader-hr" sourceRef="leaderApprove" targetRef="hrInterview"/>
    <userTask id="hrInterview" name="HR面谈">
      <extensionElements>
        <flowable:taskListener event="create" class="org.dromara.agentoa.workflow.assigner.AssigneeTaskListener">
          <flowable:field name="rule">
            <flowable:string>ROLE:hr</flowable:string>
          </flowable:field>
        </flowable:taskListener>
      </extensionElements>
    </userTask>
    <sequenceFlow id="flow-hr-end" sourceRef="hrInterview" targetRef="end"/>
    <endEvent id="end" name="结束"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_offboard">
    <bpmndi:BPMNPlane bpmnElement="offboard" id="Plane_offboard">
      <bpmndi:BPMNShape bpmnElement="start" id="Shape_start">
        <dc:Bounds height="30.0" width="30.0" x="100.0" y="135.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="leaderApprove" id="Shape_leaderApprove">
        <dc:Bounds height="80.0" width="100.0" x="230.0" y="110.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="hrInterview" id="Shape_hrInterview">
        <dc:Bounds height="80.0" width="100.0" x="430.0" y="110.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="end" id="Shape_end">
        <dc:Bounds height="30.0" width="30.0" x="630.0" y="135.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flow-start-leader" id="Edge_flow-start-leader">
        <di:waypoint x="130.0" y="150.0"/>
        <di:waypoint x="230.0" y="150.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow-leader-hr" id="Edge_flow-leader-hr">
        <di:waypoint x="330.0" y="150.0"/>
        <di:waypoint x="430.0" y="150.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow-hr-end" id="Edge_flow-hr-end">
        <di:waypoint x="530.0" y="150.0"/>
        <di:waypoint x="630.0" y="150.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
