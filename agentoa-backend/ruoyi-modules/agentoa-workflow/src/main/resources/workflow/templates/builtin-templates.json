                      "id": "branchDirector",
                      "name": "5000 元以上",
                      "condition": { "field": "amount", "op": "gt", "value": 5000 },
                      "nodes": [
                        { "id": "directorApprove", "type": "approve", "name": "总监审批", "assigneeRule": "ROLE:director", "signMode": "SINGLE" }
                      ]
                    },
                    { "id": "branchNormal", "name": "5000 元及以下", "condition": { "field": "amount", "op": "le", "value": 5000 }, "nodes": [] }
                  ]
                },
                { "id": "cashierNode", "type": "approve", "name": "出纳付款", "assigneeRule": "ROLE:cashier", "signMode": "SINGLE" }
              ]
            }
          ]
        }
